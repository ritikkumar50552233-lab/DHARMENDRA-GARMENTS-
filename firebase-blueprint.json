{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Clothing items available at Dharmendra Garments showroom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "material": { "type": "string" },
        "category": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "category", "isAvailable"]
    },
    "Category": {
      "title": "Category",
      "description": "Apparel category created by Dharmendra Garments owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "StoreInfo": {
      "title": "StoreInfo",
      "description": "Verified store business profile, contact, hours, and announcements",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "openingHours": { "type": "string" },
        "announcement": { "type": "string" },
        "announcementActive": { "type": "boolean" },
        "mapEmbedUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["shopName", "whatsappNumber"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization mapping for shop owner",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Showroom clothing items catalog"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/storeInfo/{infoId}": {
      "schema": "StoreInfo",
      "description": "Store configuration and announcements"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Store administrative accounts"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered customer profiles"
    }
  }
}
