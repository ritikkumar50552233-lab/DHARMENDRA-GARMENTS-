rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'ritikkumar50552233@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0))
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 3000))
        && data.category is string && data.category.size() <= 100
        && data.isAvailable is bool;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() <= 100;
    }

    function isValidStoreInfo(data) {
      return data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 150
        && data.whatsappNumber is string && data.whatsappNumber.size() > 0 && data.whatsappNumber.size() <= 50;
    }

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && (!('displayName' in data) || data.displayName is string && data.displayName.size() <= 100)
        && (!('phone' in data) || data.phone is string && data.phone.size() <= 50);
    }

    // 1. Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 2. Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // 3. Store Information Collection
    match /storeInfo/{infoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(infoId) && isValidStoreInfo(incoming());
      allow delete: if false;
    }

    // 4. Admin Privileges
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Admins managed through verified bootstrap
    }

    // 5. Customer Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
